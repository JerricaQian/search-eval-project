{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableWorkflows": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/validate_skill_frontmatter.py\""
          }
        ]
      }
    ]
  }
}
